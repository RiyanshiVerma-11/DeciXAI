# Frontend -> Backend connection
VITE_API_BASE_URL=http://localhost:8002

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002

# Frontend settings
FRONTEND_PORT=3003

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003

# Model persistence path (ML models)
MODEL_DIR=./models

# LLM / Groq Cloud Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_SECONDARY=your_secondary_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60

# Backward compatibility aliases
OLLAMA_API_URL=https://api.groq.com/openai/v1/chat/completions
OLLAMA_MODEL=openai/gpt-oss-120b
OLLAMA_TIMEOUT_SECONDS=60

# Gemini API (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_SECONDARY=your_secondary_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# SMTP Email configuration (for OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=DeciXAI - Decision Studio
