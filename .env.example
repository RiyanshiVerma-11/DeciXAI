# Frontend -> Backend connection
VITE_API_BASE_URL=http://localhost:8000

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend settings
FRONTEND_PORT=3000

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Model persistence path (ML models, not Ollama)
MODEL_DIR=./models

# Ollama configuration
OLLAMA_API_URL=http://host.docker.internal:11434/v1/chat/completions
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60

# Optional: Set this to use Grok or any OpenAI-compatible API instead of local Ollama
GROQ_API_KEY=
