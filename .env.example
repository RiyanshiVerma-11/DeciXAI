# Frontend -> Backend connection
VITE_API_BASE_URL=http://localhost:8002

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002

# Frontend settings
FRONTEND_PORT=3002

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

# Model persistence path (ML models)
MODEL_DIR=./models

# LLM / Groq Cloud Configuration (Primary Recommended Engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60

# Local Ollama Fallback Configuration (Optional if running locally)
OLLAMA_API_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60
